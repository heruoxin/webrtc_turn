# The domain name pointing at this server. Both the credential endpoint and
# the relay are served under it, so its DNS A record must be this machine.
PUBLIC_HOST=turn.example.com

# The password you invent. It goes in the relay URL you paste into the app.
# Generate one with: openssl rand -hex 16
ACCESS_TOKEN=

# Shared between coturn and the credential endpoint. Never leaves the server.
# Generate one with: openssl rand -hex 32
TURN_STATIC_SECRET=

# What the app is told to connect to. Add turns:${PUBLIC_HOST}:5349?transport=tcp
# here after you turn on TURN over TLS.
TURN_URLS=turn:${PUBLIC_HOST}:3478?transport=udp,turn:${PUBLIC_HOST}:3478?transport=tcp
